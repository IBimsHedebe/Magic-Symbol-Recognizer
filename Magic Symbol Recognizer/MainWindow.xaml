<Window x:Class="Magic_Symbol_Recognizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Magic_Symbol_Recognizer"
        xmlns:ctrls="clr-namespace:Magic_Symbol_Recognizer.Controls"
        mc:Ignorable="d"
        Title="Magic_Symbol_Recognizer" Height="600" Width="900">

    <Grid Background="#121212">
        <ctrls:MainMenuControl x:Name="MainMenuControl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ctrls:BattleArenaControl x:Name="BattleArenaControl" Visibility="Collapsed"/>
        <ctrls:SpellcastingControl x:Name="SpellcastingControl" Visibility="Collapsed"/>
        <ctrls:LibraryControl x:Name="LibraryControl" Visibility="Collapsed"/>

        <!-- Wiederhergestellte Header / Ranking-Anzeigen -->
        <TextBlock Text="Magie-Akademie" FontSize="28" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>
        <TextBlock x:Name="TxtRankingDisplay" Text="Ranking: 1000 LP" FontSize="14" Foreground="Gold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,18,0" FontWeight="SemiBold"/>
    </Grid>
</Window>