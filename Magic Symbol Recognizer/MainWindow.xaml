<Window x:Class="Magic_Symbol_Recognizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Magic_Symbol_Recognizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Das magische Malfeld -->
        <InkCanvas x:Name="MagicCanvas" Background="Black" Grid.Row="0">
            <InkCanvas.DefaultDrawingAttributes>
                <!-- Blaue, leuchtende magische Tinte -->
                <DrawingAttributes Color="Cyan" Width="8" Height="8"/>
            </InkCanvas.DefaultDrawingAttributes>
        </InkCanvas>

        <!-- Steuerung unten -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" Margin="10">
            <Button Content="Zauber wirken" Click="CastSpell_Click" Width="120" Height="40" Margin="5"/>
            <Button Content="Löschen" Click="ClearCanvas_Click" Width="120" Height="40" Margin="5"/>

            <Separator Width="20" Background="Transparent"/>
            <TextBox x:Name="TxtSpellName" Width="120" Height="30" VerticalContentAlignment="Center" Margin="5" ToolTip="Name des neuen Zaubers"/>
            <Button Content="Als Muster speichern" Click="SavePattern_Click" Width="130" Height="40" Margin="5" Background="DarkGreen" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
