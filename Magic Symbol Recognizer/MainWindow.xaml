<Window x:Class="Magic_Symbol_Recognizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Magic_Symbol_Recognizer"
        xmlns:ctrls="clr-namespace:Magic_Symbol_Recognizer.Controls"
        mc:Ignorable="d"
        Title="Magie-Akademie" Height="600" Width="900">

    <Grid Background="#121212">
        <ctrls:MainMenuControl x:Name="MainMenuControl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ctrls:BattleArenaControl x:Name="BattleArenaControl" Visibility="Collapsed"/>
        <ctrls:SpellcastingControl x:Name="SpellcastingControl" Visibility="Collapsed"/>
        <ctrls:LibraryControl x:Name="LibraryControl" Visibility="Collapsed"/>
    </Grid>
</Window>